{
	"luci-app-adguardhome": {
		"description": "Grant UCI access for luci-app-adguardhome",
		"read": {
			"file": {
				"/var/run/AdGredir": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"luci.adguardhome": [ "getCoreInfo", "getCoreUpdate", "getInterfaces", "getRuntimeLog" ]
			},
			"uci": [ "AdGuardHome" ]
		},
		"write": {
			"ubus": {
				"luci.adguardhome": [ "startCoreUpdate", "changeWebPassword", "clearRuntimeLog" ]
			},
			"uci": [ "AdGuardHome" ]
		}
	}
}